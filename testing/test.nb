Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"pDensity", "[", 
   RowBox[{"mmx_", ",", "mmy_", ",", "mmz_", ",", "x_", ",", "y_"}], "]"}], 
  "=", 
  RowBox[{
   RowBox[{"Last", "@", 
    RowBox[{"Cross", "[", 
     RowBox[{
      RowBox[{"Grad", "[", 
       RowBox[{
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{"mmx", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", 
          RowBox[{"mmy", "[", 
           RowBox[{"x", ",", "y"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], ",", 
      RowBox[{"Grad", "[", 
       RowBox[{
        RowBox[{"ArcCos", "[", 
         RowBox[{"mmz", "[", 
          RowBox[{"x", ",", "y"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], "]"}]}], "//", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"#", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"mmx", "[", 
          RowBox[{"x", ",", "y"}], "]"}], "^", "2"}], "+", 
        RowBox[{
         RowBox[{"mmy", "[", 
          RowBox[{"x", ",", "y"}], "]"}], "^", "2"}], "+", 
        RowBox[{
         RowBox[{"mmz", "[", 
          RowBox[{"x", ",", "y"}], "]"}], "^", "2"}]}], "\[Equal]", "1"}]}], 
     "]"}], "&"}]}]}]], "Input",
 CellChangeTimes->{{3.760874908640593*^9, 3.760875059326527*^9}, {
  3.76087509571994*^9, 3.760875118021214*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"94183bad-cf1f-4698-810a-9099bcbdda11"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{
   FractionBox["1", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox[
        RowBox[{"mmz", "[", 
         RowBox[{"x", ",", "y"}], "]"}], "2"]}], ")"}], 
     RowBox[{"3", "/", "2"}]]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["mmz", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"0", ",", "1"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"x", ",", "y"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"mmy", "[", 
           RowBox[{"x", ",", "y"}], "]"}]}], " ", 
         RowBox[{
          SuperscriptBox["mmx", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"1", ",", "0"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"mmx", "[", 
          RowBox[{"x", ",", "y"}], "]"}], " ", 
         RowBox[{
          SuperscriptBox["mmy", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"1", ",", "0"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"x", ",", "y"}], "]"}]}]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"mmy", "[", 
          RowBox[{"x", ",", "y"}], "]"}], " ", 
         RowBox[{
          SuperscriptBox["mmx", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"0", ",", "1"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"mmx", "[", 
          RowBox[{"x", ",", "y"}], "]"}], " ", 
         RowBox[{
          SuperscriptBox["mmy", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"0", ",", "1"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"x", ",", "y"}], "]"}]}]}], ")"}], " ", 
      RowBox[{
       SuperscriptBox["mmz", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"1", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"x", ",", "y"}], "]"}]}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{
  3.7608749533961573`*^9, {3.760874986699987*^9, 3.7608750237671423`*^9}, 
