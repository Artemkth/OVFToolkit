        RowBox[{"mmy", "[", 
         RowBox[{"x", ",", "y"}], "]"}], "2"]}], ")"}]}], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"mmx", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"mmy", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "2"]}], ")"}]}]]]], "Output",
 CellChangeTimes->{{3.760943665636672*^9, 3.760943675833579*^9}, 
