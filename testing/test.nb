Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mx", ",", "my", ",", "mz"}], "}"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Interpolation", "[", 
        RowBox[{"Append", "@@@", 
         RowBox[{"Transpose", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"i", ",", "j"}], "}"}], ",", 
                RowBox[{
                 RowBox[{"Sequence", "@@", 
                  RowBox[{"Transpose", "@", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"i", ",", "j"}], "}"}], ",", 
                    RowBox[{"Dimensions", "@", "#"}]}], "}"}]}]}], "//", 
                 "Evaluate"}]}], "]"}], ",", "1"}], "]"}], ",", 
            RowBox[{"Flatten", "[", 
             RowBox[{"#", ",", "1"}], "]"}]}], "}"}]}]}], "]"}], "&"}], "@", 
      RowBox[{"exFileFirstZ", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "All", ",", "2", ",", "#"}], "]"}], "]"}]}], 
     "&"}], "/@", 
    RowBox[{"Range", "[", "3", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.760874118627935*^9, 3.760874172001718*^9}, {
