Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"pDensity", "[", 
    RowBox[{"mx", ",", "my", ",", "mz", ",", "x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "1.`", ",", "194.`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "1.`", ",", "194.`"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"PlotPoints", "\[Rule]", "100"}], ",", 
   RowBox[{"RegionFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"194", "/", "2"}]}], ")"}], "^", "2"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{"194", "/", "2"}]}], ")"}], "^", "2"}]}], "\[LessEqual]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{".97", " ", 
          RowBox[{"194", "/", "2"}]}], ")"}], "^", "2"}]}]}], "]"}]}], ",", 
   RowBox[{
   "PlotLabel", "\[Rule]", "\"\<Pontryagin topological charge density\>\""}], 
   ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
