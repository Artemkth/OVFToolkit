Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"pDensity2", "[", 
   RowBox[{"mmx_", ",", "mmy_", ",", "x_", ",", "y_"}], "]"}], "=", 
  RowBox[{
   RowBox[{"Last", "@", 
    RowBox[{"Cross", "[", 
     RowBox[{
      RowBox[{"Grad", "[", 
       RowBox[{
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{"mmx", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", 
          RowBox[{"mmy", "[", 
           RowBox[{"x", ",", "y"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], ",", 
      RowBox[{"Grad", "[", 
       RowBox[{
        RowBox[{"ArcCos", "[", 
         SqrtBox[
          RowBox[{"1", "-", 
           RowBox[{
            RowBox[{"mmx", "[", 
             RowBox[{"x", ",", "y"}], "]"}], "^", "2"}], "-", 
           RowBox[{
            RowBox[{"mmy", "[", 
             RowBox[{"x", ",", "y"}], "]"}], "^", "2"}]}]], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], "]"}]}], "//", 
   "FullSimplify"}]}]], "Input",
 CellChangeTimes->{{3.7609436053689203`*^9, 3.7609436751066837`*^9}, {
  3.7609438038032513`*^9, 3.760943850765244*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"19a98306-dce4-45b2-af5d-2f1935c9e3c8"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      SuperscriptBox["mmy", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "1"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], " ", 
    RowBox[{
     SuperscriptBox["mmx", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"1", ",", "0"}], ")"}],
       Derivative],
      MultilineFunction->None], "[", 
     RowBox[{"x", ",", "y"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{
     SuperscriptBox["mmx", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"0", ",", "1"}], ")"}],
       Derivative],
      MultilineFunction->None], "[", 
     RowBox[{"x", ",", "y"}], "]"}], " ", 
    RowBox[{
     SuperscriptBox["mmy", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"1", ",", "0"}], ")"}],
       Derivative],
      MultilineFunction->None], "[", 
     RowBox[{"x", ",", "y"}], "]"}]}]}], 
  SqrtBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox[
        RowBox[{"mmx", "[", 
         RowBox[{"x", ",", "y"}], "]"}], "2"], "+", 
