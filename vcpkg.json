{
  "dependencies": [
    "boost-endian",
    "boost-program-options",
    {
		"name": "hdf5",
		"version>=": "2.1.1#1"
	},
    "tbb",
    {
		"name": "vtk",
		"version>=": "9.3.0-pv5.12.1#17"
	},
	{
		"name": "netcdf-c",
		"version>=": "4.9.3#3"
	}
  ],
  "default-features": [
    "fftw"
  ],
  "features": {
    "fftw": {
      "description": "Build the FFTW CPU backend",
      "dependencies": [
        {
          "name": "fftw3",
          "version>=": "3.3.11",
          "features": [
            "threads"
          ]
        }
      ]
    }
  }
}
